#!/usr/bin/env bash
# Controller for overnight intermediate PE-G layer extraction. Wraps
# run_pe_layer_extraction.sh with start/stop/status/log so it can be paused while
# the computer is in use and resumed later (checkpointed every 200 images/dataset,
# so a pause/resume loses at most that many).
#
#   pe_layers start    # start (or resume from last checkpoint)
#   pe_layers stop     # pause cleanly (kills the python process tree)
#   pe_layers status   # running state + per-dataset progress bars
#   pe_layers log      # tail the running log
#   pe_layers help

PIDFILE=/tmp/pe_layers.pid
LOGFILE=/tmp/pe_layers.log
HERE=/Users/abdudh/dev/utilities/reorder/clusteringRefinement
RUNNER=$HERE/run_pe_layer_extraction.sh
source "$HERE/common.sh"   # BASE + registry arrays (ALL / P)

is_running() { [[ -f $PIDFILE ]] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; }

cmd_start() {
  if is_running; then
    echo "Already running (pid $(cat $PIDFILE)). Use 'stop' first or 'status' to monitor."
    return 1
  fi
  nohup "$RUNNER" >>"$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
  echo "Started pid $(cat $PIDFILE)."
  echo "  Log: $LOGFILE   (pe_layers log)"
  echo "  Pause: pe_layers stop      Resume: pe_layers start"
}

cmd_stop() {
  if ! is_running; then echo "Not running."; rm -f "$PIDFILE"; return 0; fi
  local pid; pid=$(cat "$PIDFILE")
  pkill -P "$pid" 2>/dev/null
  pkill -f extract_pe_layers.py 2>/dev/null
  kill "$pid" 2>/dev/null
  sleep 1
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null; pkill -9 -f extract_pe_layers.py 2>/dev/null
  fi
  rm -f "$PIDFILE"
  echo "Stopped. Run 'pe_layers start' to resume from last checkpoint."
}

cmd_status() {
  if is_running; then echo "STATUS: running (pid $(cat $PIDFILE))"; else echo "STATUS: not running"; fi
  echo ""
  echo "Per-dataset progress, in grouped images (all registered datasets):"
  local dirs=() m
  for m in "${ALL[@]}"; do dirs+=("ClusteringBenchmark${P[$m]}"); done
  ~/.venvs/imgcluster-env/bin/python3 - "$BASE" "${dirs[@]}" <<'PY'
import json, os, sys
import numpy as np
base = sys.argv[1]; dirs = sys.argv[2:]
total_done = total = 0
for d in dirs:
    cache = f"{base}/{d}/.reorder-cache"
    meta_p = f"{cache}/pe_layers_meta.json"
    npz = f"{cache}/embeddings_hash_cache.npz"
    ch_p = f"{cache}/content_hashes.json"
    gr_p = f"{base}/{d}/.reorder-groups.json"
    # Mirror the runner/extractor skip conditions so the not-started rows shown
    # here are exactly the ones a `start` will actually pick up.
    if not os.path.exists(npz) or not os.path.exists(ch_p):
        print(f"  {d:<30} : (no embeddings cache — runner will skip)")
        continue
    if not os.path.exists(gr_p):
        print(f"  {d:<30} : (no .reorder-groups.json — nothing to extract)")
        continue
    m = json.load(open(meta_p)) if os.path.exists(meta_p) else None
    # Progress in grouped images (what the extractor actually encodes), derived
    # the same way extract_pe_layers.py builds its work list: npz unique-hash
    # rows whose hash belongs to a .reorder-groups.json image still on disk.
    hashes = [str(h) for h in np.load(npz, allow_pickle=False)["hashes"]]
    ch = json.load(open(ch_p))
    graw = json.load(open(gr_p))
    glist = graw if isinstance(graw, list) else graw.get("groups", [])
    gh = {str(ch[fn]) for g in glist for fn in g["images"] if fn in ch}
    wanted = [h in gh for h in hashes]
    tot = sum(wanted)
    done = 0; layers = "not started"; stale = ""
    if m:
        layers = "L" + ",".join(str(x) for x in m.get("layers", []))
        if m.get("n_images") != len(hashes):
            stale = f"  STALE (meta has {m.get('n_images')} rows — will restart fresh)"
        else:
            wm = min(m.get("completed_through", 0), len(hashes))  # row-index watermark
            done = sum(wanted[:wm])
    bar = 30; fill = int(bar * done / max(tot, 1))
    print(f"  {d:<40} : [{'#'*fill}{'.'*(bar-fill)}] {done:>5}/{tot:<5} grouped ({100.0*done/max(tot,1):5.1f}%) {layers}{stale}")
    total_done += done; total += tot
if total:
    print(f"\nOVERALL: {total_done}/{total} images ({100.0*total_done/max(total,1):.1f}%)")
else:
    print("  (nothing started yet — run 'pe_layers start')")
PY
}

cmd_log() {
  [[ -f $LOGFILE ]] || { echo "No log file yet."; return 1; }
  echo "Tailing $LOGFILE (Ctrl-C to stop watching; extraction keeps running):"
  tail -f "$LOGFILE"
}

cmd_help() {
  cat <<EOF
pe_layers — controller for overnight intermediate PE-G layer extraction.

Usage:
  pe_layers start    Start/resume extraction (resumes from last checkpoint).
  pe_layers stop     Pause cleanly. Safe to resume later.
  pe_layers status   Running state + per-dataset progress bars.
  pe_layers log      Tail the live log.
  pe_layers help     This message.

Files:
  pidfile : $PIDFILE
  log     : $LOGFILE
  outputs : <dataset>/.reorder-cache/pe_layers_L<NN>_{mean,gem3,attnpool}.npy + pe_layers_meta.json

Config (edit run_pe_layer_extraction.sh): LAYERS=$([[ -n "${LAYERS:-}" ]] && echo "$LAYERS" || echo "42,44,46,47"),
default = ALL registered datasets (partials included — needed as head-input
training data). Only images in .reorder-groups.json groups are encoded (the
head trains on grouped images only). Done/clean datasets are skipped; stale
ones (M2/M4/M7) auto-restart fresh. Override: MS_OVERRIDE="M1 M2 ...".
EOF
}

case "${1:-help}" in
  start) cmd_start ;;
  stop|pause) cmd_stop ;;
  status) cmd_status ;;
  log|tail) cmd_log ;;
  help|--help|-h) cmd_help ;;
  *) echo "unknown command: $1"; cmd_help; exit 1 ;;
esac
