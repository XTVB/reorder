#!/usr/bin/env bash
# Controller for the pixel-aug pre-extraction. Wraps run_pixel_aug_extraction.sh
# with start/stop/status/log/resume commands so it can be paused while the
# computer is in use and resumed later (the underlying extraction is checkpointed
# every 200 images per dataset, so pause/resume loses at most that many).
#
#   pixel_aug start    # start (or resume if previously paused)
#   pixel_aug stop     # stop cleanly (kills the python process tree)
#   pixel_aug status   # show running state + per-dataset progress
#   pixel_aug log      # tail the running log
#   pixel_aug help

PIDFILE=/tmp/pixel_aug.pid
LOGFILE=/tmp/pixel_aug.log
HERE=/Users/abdudh/dev/utilities/reorder/clusteringRefinement
RUNNER=$HERE/run_pixel_aug_extraction.sh
# For BASE + the registry arrays (P / PIXEL_AUG) — single source of truth.
source "$HERE/common.sh"

is_running() {
  [[ -f $PIDFILE ]] && kill -0 "$(cat $PIDFILE)" 2>/dev/null
}

cmd_start() {
  if is_running; then
    echo "Already running (pid $(cat $PIDFILE)). Use 'stop' first or 'status' to monitor."
    return 1
  fi
  # nohup + setsid so it survives terminal close.
  nohup "$RUNNER" >>"$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
  echo "Started pid $(cat $PIDFILE)."
  echo "  Log: $LOGFILE"
  echo "  Pause: pixel_aug stop"
  echo "  Resume: pixel_aug start  (resumes from last checkpoint)"
}

cmd_stop() {
  if ! is_running; then
    echo "Not running."
    rm -f "$PIDFILE"
    return 0
  fi
  local pid
  pid=$(cat "$PIDFILE")
  # Kill children first (the python extractor) so the wrapper exits cleanly.
  pkill -P "$pid" 2>/dev/null
  # Also kill any python extract_augmented_views still floating from a nested call.
  pkill -f extract_augmented_views.py 2>/dev/null
  kill "$pid" 2>/dev/null
  # Give it a moment, then force if needed.
  sleep 1
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null
    pkill -9 -f extract_augmented_views.py 2>/dev/null
  fi
  rm -f "$PIDFILE"
  echo "Stopped. Run 'pixel_aug start' to resume from last checkpoint."
}

# Show progress per dataset based on views_meta.json — no running process required.
cmd_status() {
  if is_running; then
    echo "STATUS: running (pid $(cat $PIDFILE))"
  else
    echo "STATUS: not running"
  fi
  echo ""
  echo "Per-dataset progress:"
  # Dir list comes from the shared registry (pixel-aug subset), passed as argv.
  local dirs=()
  local m
  for m in "${PIXEL_AUG[@]}"; do dirs+=("ClusteringBenchmark${P[$m]}"); done
  ~/.venvs/imgcluster-env/bin/python3 - "$BASE" "${dirs[@]}" <<'PY'
import bisect, json, os, sys
base = sys.argv[1]
dirs = sys.argv[2:]
MAX_GROUP_SIZE = 100  # mirrors extract_augmented_views.py

# Target filename indices = images in a 2..MAX_GROUP_SIZE group (the pixel-aug set).
def compute_targets(d, ch):
    gp = f"{base}/{d}/.reorder-groups.json"
    if not os.path.exists(gp):
        return None
    raw = json.load(open(gp))
    groups = raw if isinstance(raw, list) else raw.get("groups", [])
    fn_to_idx = {fn: i for i, fn in enumerate(sorted(ch))}
    tgt = set()
    for g in groups:
        imgs = g.get("images", [])
        if 2 <= len(imgs) <= MAX_GROUP_SIZE:
            tgt.update(fn_to_idx[fn] for fn in imgs if fn in fn_to_idx)
    return sorted(tgt)

total_done = total = 0
for d in dirs:
    meta_path = f"{base}/{d}/.reorder-cache/views_meta.json"
    ch_path = f"{base}/{d}/.reorder-cache/content_hashes.json"
    if not os.path.exists(ch_path):
        print(f"  {d:<24} : (no cache)")
        continue
    ch = json.load(open(ch_path))
    n_imgs = len(ch)
    completed = n_views = 0
    view_indices = None
    if os.path.exists(meta_path):
        m = json.load(open(meta_path))
        completed = m.get("completed_through", 0)
        n_views = m.get("n_views", 0)
        view_indices = m.get("view_indices")
    # Progress is measured against the target subset, not all images.
    # completed_through is a filename-index prefix, so targets-done = how many
    # target indices fall below it. Prefer the cache's own view_indices; for
    # pre-filtering caches that lack it, derive targets from the current groups.
    if view_indices is None:
        view_indices = compute_targets(d, ch)
    if view_indices is None:
        denom = n_imgs
        done = min(completed, n_imgs)
    else:
        denom = len(view_indices)
        done = bisect.bisect_left(view_indices, completed)
    bar_len = 30
    filled = int(bar_len * done / max(denom, 1))
    bar = "█" * filled + "░" * (bar_len - filled)
    pct = 100.0 * done / max(denom, 1)
    suffix = f"K={n_views}" if n_views else "(not started)"
    print(f"  {d:<30} : [{bar}] {done:>5}/{denom:<5} ({pct:5.1f}%) {suffix}")
    total_done += done
    total += denom
print()
print(f"OVERALL: {total_done}/{total} targets ({100.0*total_done/max(total,1):.1f}%)")
PY
}

cmd_log() {
  if [[ ! -f $LOGFILE ]]; then
    echo "No log file yet."
    return 1
  fi
  echo "Tailing $LOGFILE (Ctrl-C to stop watching, extraction keeps running):"
  tail -f "$LOGFILE"
}

cmd_help() {
  cat <<EOF
pixel_aug — controller for overnight pixel-augmented view extraction.

Usage:
  pixel_aug start    Start the extraction. If a previous run was paused, it
                     resumes from the last checkpoint (every 200 images).
  pixel_aug stop     Pause the extraction cleanly. Safe to resume later.
  pixel_aug status   Show whether it's running + per-dataset progress bars.
  pixel_aug log      Tail the live log.
  pixel_aug help     This message.

Files:
  pidfile : $PIDFILE
  log     : $LOGFILE
  outputs : <dataset>/.reorder-cache/pecore_g_views.npy + color_views.npy

Configured datasets (from datasets.txt, no-pixel-aug entries excluded):
  ${PIXEL_AUG[*]}
EOF
}

case "${1:-help}" in
  start)  cmd_start ;;
  stop|pause)  cmd_stop ;;
  status) cmd_status ;;
  log|tail) cmd_log ;;
  help|--help|-h) cmd_help ;;
  *) echo "unknown command: $1"; cmd_help; exit 1 ;;
esac
